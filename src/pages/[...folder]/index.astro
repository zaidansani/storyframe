---
import Footer from '@/components/Footer.astro';
import { getAllFolders, getFolderContents } from '@/lib/content/page-tree';
import { activeFonts, themeCSS } from '@/lib/utils/theme-presets';
import { withBase } from '@/lib/utils/url';
import '@/styles/layout/page-list.css';
import '@/styles/layout/theme.css';
import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  const folders = getAllFolders(pages);

  return folders.map((folder) => ({
    params: { folder },
    props: { folder, pages },
  }));
}

const { folder, pages } = Astro.props;
const { subfolders, pages: folderPages } = getFolderContents(pages, folder);
const title = folder.split('/').pop();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style set:html={themeCSS} />
    <Font cssVariable={activeFonts.body} preload />
    <Font cssVariable={activeFonts.heading} preload />
  </head>
  <body>
    <main class="page-list">
      {subfolders.map((subfolder) => (
        <button type="button" class="page-row page-row-folder" onclick={`window.location.href='${withBase(`${folder}/${subfolder}`)}'`}>
          <h2>
            <Icon name="lucide:folder" class="page-row-icon" />
            <span>/{subfolder}</span>
          </h2>
        </button>
      ))}
      {folderPages.map((page) => (
        <button type="button" class="page-row page-row-article" onclick={`window.location.href='${withBase(page.id)}'`}>
          <h2>
            <Icon name="lucide:file-text" class="page-row-icon" />
            <span>{page.data.title}</span>
          </h2>
          {page.data.description && <p class="page-description">{page.data.description}</p>}
          <p class="page-meta">
            {page.data.author && <span>{page.data.author}</span>}
            {page.data.date && (
              <span>{page.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            )}
            {page.data.read_duration && <span>{page.data.read_duration} min read</span>}
          </p>
        </button>
      ))}
    </main>
    <Footer />
  </body>
</html>

---
import Footer from '@/components/Footer.astro';
import { getFolderContents } from '@/lib/content/page-tree';
import { activeFonts, themeCSS } from '@/lib/utils/theme-presets';
import { withBase } from '@/lib/utils/url';
import '@/styles/layout/page-list.css';
import '@/styles/layout/theme.css';
import { Font } from 'astro:assets';
import { getCollection } from 'astro:content';

const LANDING_FOLDER = 'articles';

const allPages = await getCollection('pages');
const { pages } = getFolderContents(allPages, LANDING_FOLDER);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Home</title>
    <style set:html={themeCSS} />
    <Font cssVariable={activeFonts.body} preload />
    <Font cssVariable={activeFonts.heading} preload />
  </head>
  <body>
    <main class="page-list">
      {pages.map((page) => (
        <button type="button" class="page-row" onclick={`window.location.href='${withBase(page.id)}'`}>
          <h2>{page.data.title}</h2>
          {page.data.description && <p class="page-description">{page.data.description}</p>}
          <p class="page-meta">
            {page.data.author && <span>{page.data.author}</span>}
            {page.data.date && (
              <span>{page.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
            )}
            {page.data.read_duration && <span>{page.data.read_duration} min read</span>}
          </p>
        </button>
      ))}
    </main>
    <Footer />
  </body>
</html>

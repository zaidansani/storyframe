---
import "@/styles/question.css";

interface Props {
  question: string;
  answers: string[];
  caseSensitive?: boolean;
  explanation?: string;
}

const { question, answers, caseSensitive = false, explanation } = Astro.props;
---

<form
  class="question"
  data-question-root
  data-kind="fill"
  data-state="unanswered"
  data-answers={JSON.stringify(answers)}
  data-case-sensitive={caseSensitive}
>
  <p class="question-prompt">{question}</p>
  <div class="question-fill-row">
    <input type="text" class="question-fill-input" required autocomplete="off" />
  </div>
  <div class="question-actions">
    <button type="submit" class="question-submit">Check answer</button>
    <button type="button" class="question-retry">Try again</button>
  </div>
  <p class="question-feedback"></p>
  {explanation && <p class="question-explanation">{explanation}</p>}
</form>

<script>
  import "@/lib/question-client";
</script>

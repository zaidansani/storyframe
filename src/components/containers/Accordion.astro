---
import '@/styles/containers/accordion.css';

interface Props {
  allowMultiple?: boolean;
}

const { allowMultiple = false } = Astro.props;
---

<div class="accordion" data-accordion-root data-allow-multiple={allowMultiple}>
  <slot />
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-accordion-root]').forEach((root, rootIndex) => {
    const allowMultiple = root.dataset.allowMultiple === 'true';
    const items = root.querySelectorAll<HTMLElement>(':scope > .accordion-item');

    items.forEach((item, index) => {
      const trigger = item.querySelector<HTMLButtonElement>(':scope > .accordion-heading > .accordion-trigger');
      const panel = item.querySelector<HTMLElement>(':scope > .accordion-panel');
      if (!trigger || !panel) return;

      const panelId = `accordion-panel-${rootIndex}-${index}`;
      panel.id = panelId;
      trigger.setAttribute('aria-controls', panelId);

      trigger.addEventListener('click', () => {
        const expanded = trigger.getAttribute('aria-expanded') === 'true';

        if (!allowMultiple) {
          items.forEach((other) => {
            if (other === item) return;
            other.querySelector<HTMLButtonElement>(':scope > .accordion-heading > .accordion-trigger')
              ?.setAttribute('aria-expanded', 'false');
            other.classList.remove('is-open');
          });
        }

        trigger.setAttribute('aria-expanded', String(!expanded));
        item.classList.toggle('is-open', !expanded);
      });
    });
  });
</script>

---
import { Font } from 'astro:assets';
import Footer from '@/components/Footer.astro';
import ThemeToggle from '@/components/ThemeToggle.astro';
import Hero from '@/components/sections/Hero.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import { activeFonts, themeCSS } from '@/lib/theme-presets';
import '@/styles/theme.css';

interface Props {
  title: string;
  description?: string;
  date?: Date;
  author?: string;
  read_duration?: number;
}

const { title, description, date, author, read_duration } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <style set:html={themeCSS} />
    <Font cssVariable={activeFonts.body} preload />
    <Font cssVariable={activeFonts.heading} preload />
    <Font cssVariable={activeFonts.code} />
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('theme');
        if (stored === 'light' || stored === 'dark') {
          document.documentElement.setAttribute('data-theme', stored);
        }
      })();
    </script>
  </head>
  <body>
    <ThemeToggle />
    <ReadingProgress />
    <main>
      <Hero title={title} description={description} date={date} author={author} read_duration={read_duration} />
      <div class="article-content">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
